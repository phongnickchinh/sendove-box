{
  "rules": {
    ".read": false,
    ".write": false,

    "boxes": {
      "$box_id": {
        "status": {
          ".read": "auth != null && auth.uid === $box_id",
          ".write": "auth != null && auth.uid === $box_id"
        },
        "flags": {
          ".read": "auth != null && auth.uid === $box_id",
          ".write": "auth != null && auth.uid === $box_id"
        },
        "config": {
          ".read": "auth != null && auth.uid === $box_id",
          "alarm_list": {
            ".write": "auth != null && auth.uid === $box_id",
            "$alarm_id": {
              ".validate": "newData.hasChildren(['time', 'is_enable', 'repeatable'])",
              "id": { ".validate": "newData.isString() && newData.val() === $alarm_id" },
              "time": { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
              "is_enable": { ".validate": "newData.isBoolean()" },
              "repeatable": { ".validate": "newData.isBoolean()" },
              "created_at": { ".validate": "newData.isNumber()" },
              "updated_at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },

    "messages": {
      "$box_id": {
        ".read": "auth != null && auth.uid === $box_id",
        ".indexOn": ["timestamp"]
      }
    }
  }
}
