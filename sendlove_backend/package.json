{
  "name": "sendlove-backend",
  "version": "1.0.0",
  "description": "Sendove Box Backend (Firebase Functions)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
