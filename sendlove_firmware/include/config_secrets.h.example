#ifndef CONFIG_SECRETS_H
#define CONFIG_SECRETS_H

// Template file - Chép file này thành config_secrets.h và điền API Key thật của bạn

static constexpr const char *FIREBASE_HOST = "your-project-id.firebaseio.com";
static constexpr const char *FIREBASE_API_KEY = "YOUR_FIREBASE_API_KEY";
static constexpr const char *FIREBASE_AUTH_SECRET = "YOUR_DATABASE_SECRET";
static constexpr const char *BOX_ID = "box_id_001";

// Tài khoản Firebase Auth riêng của box này. Sinh ra bằng:
//   cd sendlove_backend && node scripts/provision_box_auth.js <BOX_ID>
// Script đặt uid ĐÚNG BẰNG BOX_ID để database.rules.json khớp được biểu thức
// `auth.uid === $box_id`. Mật khẩu chỉ hiện một lần lúc tạo.
static constexpr const char *BOX_AUTH_EMAIL    = "box_id_001@box.sendlove.invalid";
static constexpr const char *BOX_AUTH_PASSWORD = "YOUR_BOX_AUTH_PASSWORD";

