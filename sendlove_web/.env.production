# Applies only to `vite build` (production mode), overriding VITE_API_URL from .env.
# .env points at the emulator (127.0.0.1) for dev; Vite embeds this variable into
# the bundle AT BUILD TIME, so without this file the build deployed to Hosting
# calls localhost and breaks.
# Not a secret: the function URL is public.
VITE_API_URL=https://us-central1-iot-app-839a2.cloudfunctions.net/api
