rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mọi truy cập đọc/ghi trực tiếp đều bị chặn.
    // Upload: server cấp signed POST policy. Download: server cấp signed URL.
    // Signed URL/POST bypass các rule này (xác thực bằng chữ ký GCS), nên không bị ảnh hưởng.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
