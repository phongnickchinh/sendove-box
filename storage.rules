rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // A box reads ITS OWN media only. The box's Auth uid equals BOX_ID
    // (scripts/provision_box_auth.js) and uploads go to media/{boxId}/..., so a
    // direct comparison is enough. Requires firmware with FIREBASE_USE_IDTOKEN 1
    // (it sends `Authorization: Firebase <idToken>`).
    // ⚠️ DEPLOY ORDER: flash firmware that sends the header FIRST, then deploy this file.
    match /media/{boxId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == boxId;
    }

    // Everything else is denied. Web uploads and backend downloads use signed
    // URLs/policies, which BYPASS these rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
