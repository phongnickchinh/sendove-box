rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // An ESP32 box reads ITS OWN media, never another box's.
    //
    // Why a direct comparison works without a lookup table: the upload path is
    // `media/{boxId}/{messageId}/...` (sendlove_backend message.service.ts), and
    // the box's Auth account is created with `uid` set EXACTLY to BOX_ID
    // (scripts/provision_box_auth.js). So `request.auth.uid == boxId` is enough.
    //
    // The firmware sends `Authorization: Firebase <idToken>` — NOT `Bearer`. Only
    // effective with FIREBASE_USE_IDTOKEN 1 in the firmware; in Database Secret mode
    // the box sends NO header and is blocked here.
    //
    // ⚠️ DEPLOY ORDER: flash firmware that sends the header FIRST, then deploy this
    // file. The other way round kills media downloads immediately.
    match /media/{boxId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == boxId;
    }

    // Everything else is denied, writes included.
    // Web uploads: the server issues a signed POST policy. Backend downloads
    // (/device/poll): the server issues a v4 signed URL. Signed URLs/POSTs are
    // authenticated by the GCS signature and BYPASS these rules — unaffected.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
